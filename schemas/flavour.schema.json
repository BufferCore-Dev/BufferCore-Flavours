{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buffercore.local/schemas/flavour.schema.json",
  "title": "BufferCore Flavour",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "id",
    "displayName",
    "overrides"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "type": {
      "type": "string",
      "const": "buffercore-flavour"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "overrides": {
      "type": "object",
      "propertyNames": {
        "pattern": "^--bc-"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "semanticMappings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colour": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "light": {
              "type": "object",
              "propertyNames": {
                "pattern": "^--bc-color-"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^--bc-color-"
              }
            },
            "dark": {
              "type": "object",
              "propertyNames": {
                "pattern": "^--bc-color-"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^--bc-color-"
              }
            }
          }
        },
        "typography": {
          "type": "object",
          "propertyNames": {
            "pattern": "^--bc-type-(display|heading|paragraph|label|overline)-"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^--bc-type-"
          }
        }
      }
    }
  }
}
